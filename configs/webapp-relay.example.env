# Required public identity. The relay binds outbound sockets to this IPv4.
TENZOR_WEBAPP_RELAY_BIND=<dedicated-public-ip>:443

# Optional Nginx stream front-end. Omit to let the relay own public :443.
TENZOR_WEBAPP_RELAY_LISTEN_BIND=127.0.0.1:9443
TENZOR_WEBAPP_RELAY_METRICS_BIND=127.0.0.1:9800

TENZOR_WEBAPP_RELAY_CERT_PEM=/etc/tenzor-webapp-relay/tls/fullchain.pem
TENZOR_WEBAPP_RELAY_KEY_PEM=/etc/tenzor-webapp-relay/tls/privkey.pem
TENZOR_WEBAPP_RELAY_ID=<webapp-relay-id>
TENZOR_WEBAPP_RELAY_REGION=<region>
TENZOR_WEBAPP_RELAY_DIAGNOSTICS_HOST=<separate-canary-host>

# Include every WebApp relay/control suffix and every protected public IPv4.
# DENY_IPS must include this relay's own public IPv4 and at least one separate
# control/infrastructure IPv4. The installer copies the list into nftables.
TENZOR_WEBAPP_RELAY_DENY_HOST_SUFFIXES=<relay-domain>,<control-domain>
TENZOR_WEBAPP_RELAY_DENY_IPS=<dedicated-public-ip>,<control-public-ip>

TENZOR_WEBAPP_RELAY_HMAC_SECRET_FILE=/etc/tenzor-webapp-relay/secrets/hmac-current
# TENZOR_WEBAPP_RELAY_HMAC_PREVIOUS_SECRET_FILE=/etc/tenzor-webapp-relay/secrets/hmac-previous
TENZOR_WEBAPP_RELAY_ALLOWED_PORTS=443
TENZOR_WEBAPP_RELAY_TLS_HANDSHAKE_TIMEOUT_MS=5000
TENZOR_WEBAPP_RELAY_HEADER_TIMEOUT_MS=3000
TENZOR_WEBAPP_RELAY_CONNECT_TIMEOUT_MS=5000
TENZOR_WEBAPP_RELAY_IDLE_TIMEOUT_SECS=120
TENZOR_WEBAPP_RELAY_MAX_HEADER_BYTES=16384
TENZOR_WEBAPP_RELAY_MAX_TUNNEL_BYTES=1073741824
TENZOR_WEBAPP_RELAY_MAX_CONCURRENT=1024
TENZOR_WEBAPP_RELAY_MAX_CONCURRENT_PER_SUB=64
TENZOR_WEBAPP_RELAY_MAX_CONCURRENT_PER_JTI=32
TENZOR_WEBAPP_RELAY_CLOCK_SKEW_SECS=15
TENZOR_WEBAPP_RELAY_MAX_TOKEN_LIFETIME_SECS=900
TENZOR_WEBAPP_RELAY_GRACEFUL_DRAIN_TIMEOUT_SECS=30
